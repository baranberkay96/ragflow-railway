# Adapted from infiniflow/ragflow docker/service_conf.yaml.template (v0.27.2, Apache-2.0).
# Changes for the Railway template: object storage goes to an S3-compatible Railway
# Bucket (STORAGE_IMPL=AWS_S3, virtual-hosted addressing, single bucket + prefix),
# the unused TEI default-embedding block is removed, Redis port is configurable and
# passwords have no built-in defaults. Values are filled from environment variables
# by docker/entrypoint.sh at container start.
general:
  heartbeat_interval: 3s
ragflow:
  host: ${RAGFLOW_HOST:-0.0.0.0}
  http_port: 9380
admin:
  host: ${RAGFLOW_HOST:-0.0.0.0}
  http_port: 9381
mysql:
  name: '${MYSQL_DBNAME:-rag_flow}'
  user: '${MYSQL_USER:-root}'
  password: '${MYSQL_PASSWORD}'
  host: '${MYSQL_HOST:-mysql}'
  port: ${MYSQL_PORT:-3306}
  max_connections: 900
  stale_timeout: 300
  max_allowed_packet: ${MYSQL_MAX_PACKET:-1073741824}
minio:
  user: '${MINIO_USER:-rag_flow}'
  password: '${MINIO_PASSWORD:-unused}'
  host: '${MINIO_HOST:-minio}:9000'
  bucket: '${MINIO_BUCKET:-}'
  prefix_path: '${MINIO_PREFIX_PATH:-}'
s3:
  access_key: '${S3_ACCESS_KEY}'
  secret_key: '${S3_SECRET_KEY}'
  region: '${S3_REGION:-auto}'
  endpoint_url: '${S3_ENDPOINT_URL}'
  bucket: '${S3_BUCKET}'
  prefix_path: '${S3_PREFIX_PATH:-ragflow}'
  signature_version: 'v4'
  addressing_style: '${S3_ADDRESSING_STYLE:-virtual}'
es:
  hosts: 'http://${ES_HOST:-es01}:${ES_PORT_INTERNAL:-9200}'
  username: '${ES_USER:-elastic}'
  password: '${ELASTIC_PASSWORD}'
os:
  hosts: 'http://${OS_HOST:-opensearch01}:9201'
  username: '${OS_USER:-admin}'
  password: '${OPENSEARCH_PASSWORD:-unused}'
infinity:
  uri: '${INFINITY_HOST:-infinity}:23817'
  postgres_port: 5432
  db_name: 'default_db'
redis:
  db: 1
  username: '${REDIS_USERNAME:-}'
  password: '${REDIS_PASSWORD}'
  host: '${REDIS_HOST:-redis}:${REDIS_PORT:-6379}'
nats:
  host: ${NATS_HOST:-0.0.0.0}
  port: ${NATS_PORT:-4222}
otel:
  host: ${OTEL_HOST:-0.0.0.0}
  port: ${OTEL_PORT:-4318}
  secure: false
  sample_ratio: 1.0
  stdout: false
  enable: false
ingestor:
  mq_type: 'nats'
  max_concurrent_workers: 2
  compiler_pool_size: 0
file_syncer:
  max_concurrent_syncs: 5
